{
  "name": "platform-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run db:generate --workspace=@platform/database && npm run build --workspace=web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "build:web": "npm run db:generate --workspace=@platform/database && npm run build --workspace=web",
    "start:web": "npm run start --workspace=web",
    "build:host": "npm run build --workspace=host",
    "start:host": "npm run start --workspace=host",
    "build:admin": "npm run build --workspace=admin",
    "start:admin": "npm run start --workspace=admin",
    "build:api": "npm run build --workspace=@platform/config && npm run build --workspace=@platform/types && npm run build --workspace=@platform/auth && npm run build --workspace=@platform/database && npm run build --workspace=@platform/logger && npm run build --workspace=@platform/validation && npm run build --workspace=api",
    "start:api": "npm run start:prod --workspace=api",
    "build:worker": "npm run build --workspace=worker",
    "start:worker": "npm run start --workspace=worker",
    "build:all": "turbo build",
    "start": "npm run start --workspace=web"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
